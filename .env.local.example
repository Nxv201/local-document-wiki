# ============================================================
# Local Document Wiki — Environment Variables
# Copy this file to .env in the project root and fill in values
# ============================================================

# ---- Embedder + Vision LLM (RTX 3060 — localhost) ----
DEEPWIKI_EMBEDDER_TYPE=ollama

# Ollama host for embedding model (nomic-embed-text) and Vision LLM (qwen2.5vl:7b)
# This is the LOCAL machine running the RTX 3060
OLLAMA_HOST=http://localhost:11434

# ---- Text Generation LLM (AGX Orin) ----
# Ollama host for the text generation LLM (qwen2.5:27b)
# Set this to the IP or hostname of the AGX Orin on your network
OLLAMA_GENERATOR_HOST=http://AGX_ORIN_IP:11434

# ---- Vision LLM model (for PPTX slide / PDF page extraction) ----
# Runs on localhost (RTX 3060)
VISION_LLM_MODEL=qwen2.5vl:7b

# ---- Optional: disable auth for local use ----
DEEPWIKI_AUTH_MODE=False

# ---- Optional: custom config dir ----
# DEEPWIKI_CONFIG_DIR=/path/to/custom/config
